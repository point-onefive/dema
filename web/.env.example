# ─────────────────────────────────────────────────────────────
# DEMA - Environment Variables
#
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to git.
# ─────────────────────────────────────────────────────────────

# Resend API key - get this from resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# The email address that receives a notification every time
# someone joins the waitlist. Use your own email here.
NOTIFY_EMAIL=your@email.com

# The "from" address used when sending emails.
# For testing, you can use: Dema <onboarding@resend.dev>
# For production, set up your domain in Resend and use: Dema <hello@yourdomain.com>
FROM_EMAIL=Dema <onboarding@resend.dev>
